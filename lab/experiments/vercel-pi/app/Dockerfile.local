# Local stand-in for the Vercel build, used only to test before deploying.
FROM node:24.21.0-trixie-slim
WORKDIR /app
COPY package.json ./
RUN npm install --no-audit --no-fund
COPY . .
RUN npx next build && chown -R node:node /app
USER node
ENV NODE_ENV=production
CMD ["node", "node_modules/next/dist/bin/next", "start", "-p", "3200"]
