  "kind": "write",
  "path": "components/Stats.tsx",
  "content": "type Props = { values: number[] };\n\nexport default function Stats({ values }: Props) {\n  const n = values.length;\n  const mean = n ? values.reduce((a, b) => a + b, 0) / n : 0;\n  const max = n ? Math.max(...values) : 0;\n  return (\n    <aside className=\"rounded-lg bg-gray-50 p-3 text-sm\">\n      <p>Mean {mean.toFixed(2)}</p>\n      <p>Max {max.toFixed(2)}</p>\n      <p>Count {n}</p>\n    </aside>\n  );\n}\n"
 },
