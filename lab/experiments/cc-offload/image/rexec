#!/bin/bash
# rexec B64_COMMAND B64_CWD TIMEOUT_S: run a command on the tools container, print its output, exit with its exit code.
cmd=$(printf %s "$1" | base64 -d); cwd=$(printf %s "$2" | base64 -d)
out="/tmp/cco-out.$$"
code=$(jq -cn --arg c "$cmd" --arg d "$cwd" --argjson t "${3:-600}" '{cmd: $c, cwd: $d, timeout: $t}' \
  | curl -s -o "$out" -w '%header{x-exit-code}' --max-time $(( ${3:-600} + 30 )) -H 'content-type: application/json' \
         --data-binary @- "$CCO_TOOLS/exec")
cat "$out"
exit "${code:-1}"
