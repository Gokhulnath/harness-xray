// Agent-lab kernel tracer: every process, thread, syscall, file, socket and signal in the agent
// container's cgroup. CG is replaced by the sampler with the container's cgroup path.
// Output: one tab-separated line per record (parsed by sampler.py). Pids are VM root-namespace
// pids; nspid is the pid inside the container. ts = nsecs(boot), converted to wall clock later.
//
// Immediate events
//   A  ts pid tid comm filename argv1..argv4          execve() entry: what is being run
//   X  ts pid tid ppid euid nspid comm filename       exec succeeded
//   F  ts parent_pid child_tid                        fork/clone (threads included)
//   E  ts pid tid ppid euid nspid comm runtime_ns utime_ns stime_ns maxrss_kb start_ns minflt majflt
//      nvcsw nivcsw run_delay_ns timeslices rchar wchar syscr syscw read_bytes write_bytes
//      every thread exit; runtime_ns = exact CFS CPU time; run_delay = time spent runnable but waiting
//   D  ts pid tid runtime_ns                          final context switch of an exiting task (complete runtime)
//   M  ts pid tid hiwater_rss file anon shmem         memory map at do_exit (pages); real peak RSS
//   T  ts pid comm oldstate newstate saddr sport daddr dport   TCP state change (IPv4)
//   S  ts sender_pid sender_comm target_pid target_comm signal result   signal generated by a task in the cgroup
// Per-second aggregates (printed then cleared; each block ends with a TICK line)
//   SY pid comm syscall_id count total_ns             syscalls by thread name (comm = thread name)
//   FR/FW pid comm ftype parent name bytes ops        file reads / writes by file (ftype = S_IFMT >> 12)
//   OP pid comm filename count                        openat() targets
//   NT pid comm kind bytes                            tcp_tx tcp_rx udp_tx udp_rx unix_tx unix_rx
//   BK comm rwbs bytes                                block-device requests issued (VM-wide; writeback shows as kworker)

tracepoint:syscalls:sys_enter_execve /cgroup == cgroupid("CG")/ {
	$n = 0;
	if (args.argv[1] != 0) { $n = 1; if (args.argv[2] != 0) { $n = 2; if (args.argv[3] != 0) { $n = 3; if (args.argv[4] != 0) { $n = 4; } } } }
	printf("A\t%llu\t%d\t%d\t%s\t%s\t%s\t%s\t%s\t%s\n", nsecs(boot), pid, tid, comm, str(args.filename),
		$n >= 1 ? str(args.argv[1]) : "", $n >= 2 ? str(args.argv[2]) : "", $n >= 3 ? str(args.argv[3]) : "", $n >= 4 ? str(args.argv[4]) : "");
}

tracepoint:sched:sched_process_exec /cgroup == cgroupid("CG")/ {
	printf("X\t%llu\t%d\t%d\t%d\t%d\t%d\t%s\t%s\n", nsecs(boot), pid, tid, curtask->real_parent->tgid,
		curtask->cred->euid.val, curtask->thread_pid->numbers[1].nr, comm, str(args.filename));
}

tracepoint:sched:sched_process_fork /cgroup == cgroupid("CG")/ {
	printf("F\t%llu\t%d\t%d\n", nsecs(boot), args.parent_pid, args.child_pid);
}

tracepoint:sched:sched_process_exit /cgroup == cgroupid("CG")/ {
	printf("E\t%llu\t%d\t%d\t%d\t%d\t%d\t%s\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%llu\n",
		nsecs(boot), pid, tid, curtask->real_parent->tgid, curtask->cred->euid.val, curtask->thread_pid->numbers[1].nr, comm,
		curtask->se.sum_exec_runtime, curtask->utime, curtask->stime, curtask->signal->maxrss * 4, curtask->start_time,
		curtask->min_flt, curtask->maj_flt, curtask->nvcsw, curtask->nivcsw,
		curtask->sched_info.run_delay, curtask->sched_info.pcount,
		curtask->ioac.rchar, curtask->ioac.wchar, curtask->ioac.syscr, curtask->ioac.syscw, curtask->ioac.read_bytes, curtask->ioac.write_bytes);
}

// a thread that exits inside a syscall (exit_group never returns) must not leak per-thread state
tracepoint:sched:sched_process_exit { delete(@sc_t[tid]); delete(@sc_id[tid]); delete(@rf[tid]); delete(@wf[tid]); }

tracepoint:sched:sched_switch /(curtask->flags & 0x4) && cgroup == cgroupid("CG")/ {
	printf("D\t%llu\t%d\t%d\t%llu\n", nsecs(boot), pid, tid, curtask->se.sum_exec_runtime);
}

kprobe:do_exit /cgroup == cgroupid("CG") && curtask->mm != 0/ {
	printf("M\t%llu\t%d\t%d\t%llu\t%lld\t%lld\t%lld\n", nsecs(boot), pid, tid, curtask->mm->hiwater_rss,
		curtask->mm->rss_stat[0].count, curtask->mm->rss_stat[1].count, curtask->mm->rss_stat[3].count);
}

tracepoint:sock:inet_sock_set_state /cgroup == cgroupid("CG") && args.family == 2/ {
	printf("T\t%llu\t%d\t%s\t%d\t%d\t%s\t%d\t%s\t%d\n", nsecs(boot), pid, comm, args.oldstate, args.newstate,
		ntop(args.saddr), args.sport, ntop(args.daddr), args.dport);
}

tracepoint:signal:signal_generate /cgroup == cgroupid("CG")/ {
	printf("S\t%llu\t%d\t%s\t%d\t%s\t%d\t%d\n", nsecs(boot), pid, comm, args.pid, args.comm, args.sig, args.result);
}

// ---------------- syscalls: count + time per thread name
tracepoint:raw_syscalls:sys_enter /cgroup == cgroupid("CG")/ {
	@sc_t[tid] = nsecs;
	@sc_id[tid] = args.id;
}
tracepoint:raw_syscalls:sys_exit /@sc_t[tid]/ {
	@sy[pid, comm, @sc_id[tid]] = count();
	@syns[pid, comm, @sc_id[tid]] = sum(nsecs - @sc_t[tid]);
	delete(@sc_t[tid]);
	delete(@sc_id[tid]);
}

// ---------------- file I/O by file (entry stores the file, return adds actual bytes)
kprobe:vfs_read, kprobe:vfs_readv /cgroup == cgroupid("CG")/ { @rf[tid] = arg0; }
kretprobe:vfs_read, kretprobe:vfs_readv /@rf[tid]/ {
	$f = (struct file *)@rf[tid];
	$k = (pid, comm, ($f->f_inode->i_mode >> 12) & 15, str($f->f_path.dentry->d_parent->d_name.name, 32), str($f->f_path.dentry->d_name.name, 64));
	@fr[$k] = sum((int64)retval > 0 ? retval : 0);
	@frn[$k] = count();
	delete(@rf[tid]);
}
kprobe:vfs_write, kprobe:vfs_writev /cgroup == cgroupid("CG")/ { @wf[tid] = arg0; }
kretprobe:vfs_write, kretprobe:vfs_writev /@wf[tid]/ {
	$f = (struct file *)@wf[tid];
	$k = (pid, comm, ($f->f_inode->i_mode >> 12) & 15, str($f->f_path.dentry->d_parent->d_name.name, 32), str($f->f_path.dentry->d_name.name, 64));
	@fw[$k] = sum((int64)retval > 0 ? retval : 0);
	@fwn[$k] = count();
	delete(@wf[tid]);
}
tracepoint:syscalls:sys_enter_openat /cgroup == cgroupid("CG")/ { @op[pid, comm, str(args.filename, 96)] = count(); }

// ---------------- network bytes per process
kprobe:tcp_sendmsg /cgroup == cgroupid("CG")/ { @nt[pid, comm, "tcp_tx"] = sum(arg2); }
kprobe:tcp_cleanup_rbuf /cgroup == cgroupid("CG") && (int32)arg1 > 0/ { @nt[pid, comm, "tcp_rx"] = sum((int32)arg1); }
kprobe:udp_sendmsg /cgroup == cgroupid("CG")/ { @nt[pid, comm, "udp_tx"] = sum(arg2); }
kretprobe:udp_recvmsg /cgroup == cgroupid("CG") && (int64)retval > 0/ { @nt[pid, comm, "udp_rx"] = sum(retval); }
kprobe:unix_stream_sendmsg, kprobe:unix_dgram_sendmsg /cgroup == cgroupid("CG")/ { @nt[pid, comm, "unix_tx"] = sum(arg2); }
kretprobe:unix_stream_recvmsg /cgroup == cgroupid("CG") && (int64)retval > 0/ { @nt[pid, comm, "unix_rx"] = sum(retval); }

// ---------------- block I/O (VM-wide: the issuing task is often a kernel writeback thread)
tracepoint:block:block_rq_issue { @bk[args.comm, args.rwbs] = sum(args.bytes); }

interval:ms:1000 {
	for ($kv : @sy) { printf("SY\t%d\t%s\t%d\t%lld\t%lld\n", $kv.0.0, $kv.0.1, $kv.0.2, (int64)$kv.1, (int64)@syns[$kv.0.0, $kv.0.1, $kv.0.2]); }
	for ($kv : @fr) { printf("FR\t%d\t%s\t%d\t%s\t%s\t%lld\t%lld\n", $kv.0.0, $kv.0.1, $kv.0.2, $kv.0.3, $kv.0.4, (int64)$kv.1, (int64)@frn[$kv.0]); }
	for ($kv : @fw) { printf("FW\t%d\t%s\t%d\t%s\t%s\t%lld\t%lld\n", $kv.0.0, $kv.0.1, $kv.0.2, $kv.0.3, $kv.0.4, (int64)$kv.1, (int64)@fwn[$kv.0]); }
	for ($kv : @op) { printf("OP\t%d\t%s\t%s\t%lld\n", $kv.0.0, $kv.0.1, $kv.0.2, (int64)$kv.1); }
	for ($kv : @nt) { printf("NT\t%d\t%s\t%s\t%lld\n", $kv.0.0, $kv.0.1, $kv.0.2, (int64)$kv.1); }
	for ($kv : @bk) { printf("BK\t%s\t%s\t%lld\n", $kv.0.0, $kv.0.1, (int64)$kv.1); }
	clear(@sy); clear(@syns); clear(@fr); clear(@frn); clear(@fw); clear(@fwn); clear(@op); clear(@nt); clear(@bk);
	printf("TICK\t%llu\n", nsecs(boot));
}

END { clear(@sc_t); clear(@sc_id); clear(@rf); clear(@wf); }
